# Discord Bot Configuration
# Get your Discord bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# RapidAPI Configuration for Rocket League API
# Get your API key from: https://rapidapi.com/rocket-league-rocket-league-default/api/rocket-league1
# 1. Sign up/login to RapidAPI
# 2. Subscribe to the Rocket League API (free tier available)
# 3. Copy your API key from the "X-RapidAPI-Key" header
RAPIDAPI_KEY=your_rapidapi_key_here